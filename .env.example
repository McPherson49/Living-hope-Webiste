# Copy to .env.local (local) or set these in your hosting dashboard (production).

# Public URL of the live site — used for canonical URLs, the sitemap and social cards.
# Search engines stay blocked until this is a real (non-localhost) URL AND the phone
# number + street address in src/content/site.ts are filled in.
NEXT_PUBLIC_SITE_URL=https://www.your-hospital-domain.com

# Google Analytics 4 measurement ID (optional). Enables page views plus events for
# call, WhatsApp and email clicks and form submissions.
NEXT_PUBLIC_GA_ID=

# Appointment + contact form email (Resend — https://resend.com). Without all three,
# forms work in development (submissions are logged to the terminal) but return a
# "please call us" error in production, so nobody is told a request was sent when it wasn't.
RESEND_API_KEY=
EMAIL_FROM="Living Hope Hospital <appointments@your-hospital-domain.com>"
# One or more front-desk inboxes, comma-separated.
FRONT_DESK_EMAIL=frontdesk@your-hospital-domain.com
